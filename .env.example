# --- общее ---
DATA_DIR=./data
INGEST_MODE=local_fs          # local_fs | dropbox_webhook (VDS позже)
PUBLISH_MODE=github_pages     # github_pages | filesystem | s3

# папка Dropbox Desktop, куда HealthFit кладёт .fit
WATCH_DIR=/Users/yambikov/Library/CloudStorage/Dropbox/Приложения/HealthFitExporter

# URL шаблона для nakarte (только для подсказки / логов)
TILE_URL_PREFIX=https://<user>.github.io/<repo>/tiles/activity-heatmap

# --- рендер (стиль Komoot tracks) ---
# марганцовка: фиолетово-малиновый
COLOR_RGB=128,24,110
ALPHA_MIN=0.28
ALPHA_MAX=0.96
COUNT_REF=p99
LINE_WIDTH_PX=2.5
Z_MIN=6
Z_MAX=15
BBOX_MARGIN_M=2000
FREQ_WIDTH=1

# --- publish: github_pages ---
GITHUB_PAGES_REPO=
GITHUB_PAGES_BRANCH=gh-pages
GITHUB_TOKEN=

# --- VDS / webhook (позже) ---
# DROPBOX_APP_KEY=
# DROPBOX_REFRESH_TOKEN=
# PUBLIC_BASE_URL=https://tiles.example.com

# --- publish: s3 / R2 (опционально) ---
# S3_ENDPOINT=
# S3_BUCKET=
# S3_PREFIX=tiles/activity-heatmap
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
