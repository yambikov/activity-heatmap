# --- общее ---
DATA_DIR=./data
INGEST_MODE=local_fs          # local_fs
PUBLISH_MODE=github_pages     # github_pages | filesystem

# папка Dropbox Desktop, куда HealthFit кладёт .fit
WATCH_DIR=/Users/yambikov/Library/CloudStorage/Dropbox/Приложения/HealthFitExporter

# URL префикса для nakarte (без /{z}/{x}/{y}.png)
# С секретным путём: https://<user>.github.io/<repo>/<PAGES_SECRET_PATH>/activity-heatmap
TILE_URL_PREFIX=https://<user>.github.io/<repo>/<PAGES_SECRET_PATH>/activity-heatmap

# --- рендер (стиль Komoot tracks) ---
# марганцовка: фиолетово-малиновый
COLOR_RGB=128,24,110
ALPHA_MIN=0.28
ALPHA_MAX=0.96
COUNT_REF=p99
LINE_WIDTH_PX=2.5
Z_MIN=6
Z_MAX=15
BBOX_MARGIN_M=2000
FREQ_WIDTH=1

# --- publish: github_pages ---
# owner/repo (публичный репо — Pages бесплатно; секретный сегмент = obscurity)
GITHUB_PAGES_REPO=
GITHUB_PAGES_BRANCH=gh-pages
# опционально: PAT с правом contents:write; иначе SSH (git@github.com)
GITHUB_TOKEN=
# длинный случайный токен (один сегмент пути). Сгенерировать:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
PAGES_SECRET_PATH=
